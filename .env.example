# Copy this file to .env.local and fill in real values from your Supabase project
# (Project Settings -> API in the Supabase dashboard)

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Only used server-side for admin tasks (never expose to the browser).
# Not required for Phase 1, but reserved for later (e.g. platform-level admin tools).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
